! X colors.
! Generated by 'wal'
*foreground:        #cbc2cb
*background:        #111012
*.foreground:       #cbc2cb
*.background:       #111012
emacs*foreground:   #cbc2cb
emacs*background:   #111012
URxvt*foreground:   #cbc2cb
XTerm*foreground:   #cbc2cb
UXTerm*foreground:  #cbc2cb
URxvt*background:   [100]#111012
XTerm*background:   #111012
UXTerm*background:  #111012
URxvt*cursorColor:  #cbc2cb
XTerm*cursorColor:  #cbc2cb
UXTerm*cursorColor: #cbc2cb
URxvt*borderColor:  [100]#111012

! Colors 0-15.
*.color0: #111012
*color0:  #111012
*.color1: #80647F
*color1:  #80647F
*.color2: #925390
*color2:  #925390
*.color3: #A95BA8
*color3:  #A95BA8
*.color4: #AD67AC
*color4:  #AD67AC
*.color5: #C171BF
*color5:  #C171BF
*.color6: #C372C1
*color6:  #C372C1
*.color7: #cbc2cb
*color7:  #cbc2cb
*.color8: #8e878e
*color8:  #8e878e
*.color9: #80647F
*color9:  #80647F
*.color10: #925390
*color10:  #925390
*.color11: #A95BA8
*color11:  #A95BA8
*.color12: #AD67AC
*color12:  #AD67AC
*.color13: #C171BF
*color13:  #C171BF
*.color14: #C372C1
*color14:  #C372C1
*.color15: #cbc2cb
*color15:  #cbc2cb

! Black color that will not be affected by bold highlighting.
*.color66: #111012
*color66:  #111012

! Xclock colors.
XClock*foreground: #cbc2cb
XClock*background: #111012
XClock*majorColor:  rgba:cb/c2/cb/ff
XClock*minorColor:  rgba:cb/c2/cb/ff
XClock*hourColor:   rgba:cb/c2/cb/ff
XClock*minuteColor: rgba:cb/c2/cb/ff
XClock*secondColor: rgba:cb/c2/cb/ff

! Set depth to make transparency work.
URxvt*depth: 32
